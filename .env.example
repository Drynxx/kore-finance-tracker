# Appwrite Backend Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id
VITE_APPWRITE_COLLECTION_ID=transaction
VITE_APPWRITE_WALLPAPER_BUCKET_ID=your_storage_bucket_id

# Optional Cloud Functions
VITE_APPWRITE_FUNCTION_ID_GEMINI=your_agent_function_id
VITE_APPWRITE_FUNCTION_ID_ELEVENLABS=your_elevenlabs_function_id

# Optional Text-to-Speech (ElevenLabs)
VITE_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Kore Personal Agent: Neural Inference Engine Keys
# Priority 1: Primary Inference API Key (Google AI Studio)
GEMINI_API_KEY=your_inference_api_key

# Priority 2: Secondary Inference Provider (Optional Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key
